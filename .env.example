# =====================================================
# NEXORA — Environment configuration template
# Copy this file to .env and fill in real values.
# Never commit a real .env file.
# =====================================================

# Runtime mode: development | production | test
NODE_ENV=development

# Backend HTTP port
PORT=5000

# MongoDB connection string (local or Atlas)
# Examples:
#   Local:  mongodb://127.0.0.1:27017/nexora
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nexora
MONGO_URI=

# Frontend origin allowed by CORS (used by the backend)
CLIENT_URL=http://localhost:5173

# Secret used to sign JWTs.
# REQUIRED for /api/v1/auth/* to work. The server fails to boot if missing.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# JWT lifetime. jsonwebtoken syntax — e.g. "7d", "12h", "30m".
# Documented default: 7 days. Do not use "never" / infinite tokens.
JWT_EXPIRES_IN=7d

# Bcrypt cost factor for password hashing (rounds).
# 10 is a sensible production default; higher = slower + safer.
BCRYPT_ROUNDS=10

# =====================================================
# Frontend (Vite) — placed in client/.env (e.g. client/.env.local).
# Only variables prefixed VITE_ are exposed to the React bundle.
# NEVER put backend secrets (JWT_SECRET, MONGO_URI, BCRYPT_ROUNDS) here.
# =====================================================
# VITE_API_BASE_URL=http://localhost:5000/api/v1
